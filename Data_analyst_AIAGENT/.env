# --- LLM (OpenRouter, OpenAI-compatible API) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b

# --- Optional Langfuse tracing (leave blank to disable) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Guardrail limits ---
MAX_UPLOAD_FILE_SIZE_MB=25
MAX_BUSINESS_CONTEXT_FILE_SIZE_MB=15
ALLOWED_DATA_EXTENSIONS=.csv,.xlsx
ALLOWED_CONTEXT_EXTENSIONS=.pdf,.txt

# --- Observability ---
# Keep false on Hugging Face Spaces (only one port is exposed there).
# Set true for local/Docker runs if you want a real /metrics endpoint for Prometheus.
ENABLE_METRICS_SERVER=false
METRICS_SERVER_PORT=9108
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Storage paths (defaults shown; override rarely needed) ---
TRACE_DB_PATH=data/db/traces.sqlite
MEMORY_DB_PATH=data/db/memory.sqlite
